<%- include('head', { isAdminPage: true }) %>
<%
  const current = locals.currentPath || '';
  const is = p => current === p ? 'aria-current="page"' : '';
%>
<header class="bg-surface border-b border-outline-variant sticky top-0 z-50">
  <div class="flex justify-between items-center gap-md h-16 px-md md:px-lg">
    <div class="flex items-center gap-md min-w-0">
      <a href="/admin" class="text-headline-sm font-bold text-on-surface no-underline whitespace-nowrap">অ্যাডমিন প্যানেল</a>
      <a href="/" class="hidden sm:inline text-label-md text-on-surface-variant">পাবলিক সাইট দেখুন</a>
    </div>
    <div class="flex items-center gap-sm min-w-0">
      <div class="hidden sm:block text-right min-w-0">
        <p class="text-label-md font-bold truncate"><%= user.username %><% if (user.isDeveloper) { %> <span class="badge badge-upcoming">ডেভেলপার</span><% } %></p>
        <p class="text-[11px] text-on-surface-variant truncate"><%= user.adminWiki %><% if (user.isMock) { %> · <strong class="text-error">মক লগ ইন</strong><% } %></p>
      </div>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-ghost btn-sm text-error" type="submit"><%- icon('logout', 'icon-sm') %><span class="hidden sm:inline">লগ আউট</span></button>
      </form>
    </div>
  </div>
</header>
<div class="flex flex-1 w-full">
  <aside class="hidden md:flex flex-col w-60 shrink-0 bg-surface-container-low border-r border-outline-variant p-md gap-xs">
    <a class="side-link" href="/admin" <%- is('/admin') %>><%- icon('dashboard') %> ইভেন্ট ও আবেদন</a>
    <a class="side-link" href="/admin/events/new" <%- is('/admin/events/new') %>><%- icon('add_circle') %> নতুন ইভেন্ট</a>
    <a class="side-link" href="/admin/settings" <%- is('/admin/settings') %>><%- icon('settings') %> সাধারণ সেটিংস</a>
    <% if (user.isDeveloper) { %>
      <a class="side-link" href="/admin/audit" <%- is('/admin/audit') %>><%- icon('history') %> কার্যক্রমের লগ</a>
    <% } %>
    <a class="side-link mt-auto" href="/events"><%- icon('leaderboard') %> পাবলিক পরিসংখ্যান</a>
  </aside>
  <main id="main" class="flex-1 min-w-0 p-md md:p-lg pb-24 md:pb-lg">
