PORT=3000
# Set to "production" on Toolforge. Enables secure cookies, trusted proxy and strict checks.
NODE_ENV=development
# Number of proxies in front of the app (Toolforge: 1). Defaults to 1 when NODE_ENV=production.
TRUST_PROXY=
WIKIMEDIA_CLIENT_ID=your_client_id_here
WIKIMEDIA_CLIENT_SECRET=your_client_secret_here
WIKIMEDIA_REDIRECT_URI=http://localhost:3000/auth/callback
# At least 16 random characters, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=some_random_session_secret_string
# Comma-separated usernames with developer (super admin) rights
DEVELOPER_USERNAMES=Yahya
# Wiki user groups (on bn.wikipedia.org / bd.wikimedia.org) allowed into the admin panel
ALLOWED_GROUPS=sysop
# Local testing only: log in without OAuth via /login?user=Name&wiki=bd. Ignored in production.
ENABLE_MOCK_LOGIN=false
