# Copy this file to .env and fill in the values.

PORT=3000
# Use "production" on Toolforge: secure cookies, trusted proxy and strict checks.
NODE_ENV=development
# Number of proxies in front of the app (Toolforge: 1). Defaults to 1 when NODE_ENV=production.
TRUST_PROXY=
# Public address used in QR codes and links, e.g. https://acd.toolforge.org
PUBLIC_URL=

# Wikimedia OAuth 2.0 consumer (https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration)
WIKIMEDIA_CLIENT_ID=your_client_id_here
WIKIMEDIA_CLIENT_SECRET=your_client_secret_here
WIKIMEDIA_REDIRECT_URI=http://localhost:3000/auth/callback

# At least 16 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=some_random_session_secret_string

# Comma-separated usernames with developer (super admin) rights: see emails, download logs, delete events
DEVELOPER_USERNAMES=Yahya
# Wiki user groups allowed into the admin panel, checked on ADMIN_WIKIS
ALLOWED_GROUPS=sysop
ADMIN_WIKIS=bn.wikipedia.org,bd.wikimedia.org

# Days after a decision before applicants' email addresses are deleted
EMAIL_RETENTION_DAYS=90
# Minutes between automatic statistics updates
STATS_POLL_MINUTES=5
CONTACT_EMAIL=yahya@wikimedia.org.bd
# Database file (default: database.sqlite in the project folder)
DB_PATH=

# Local testing only: log in without OAuth via /login?user=Name&wiki=bd.
# Account approvals are simulated. Ignored when NODE_ENV=production.
ENABLE_MOCK_LOGIN=false
